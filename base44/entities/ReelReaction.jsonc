{
  "name": "ReelReaction",
  "type": "object",
  "properties": {
    "reel_id": {
      "type": "string",
      "description": "The ID of the reel being reacted to"
    },
    "emoji": {
      "type": "string",
      "enum": [
        "\u2764\ufe0f",
        "\ud83d\ude02",
        "\ud83d\ude0d",
        "\ud83d\ude21",
        "\ud83d\udd25",
        "\ud83d\ude22"
      ],
      "description": "Emoji reaction type"
    }
  },
  "required": [
    "reel_id",
    "emoji"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}