{
  "name": "Friend",
  "type": "object",
  "properties": {
    "requester_email": {
      "type": "string",
      "description": "Email of the user sending the friend request"
    },
    "recipient_email": {
      "type": "string",
      "description": "Email of the user receiving the friend request"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending",
      "description": "The status of the friend request"
    }
  },
  "required": [
    "requester_email",
    "recipient_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "requester_email": "{{user.email}}"
        },
        {
          "recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "requester_email": "{{user.email}}"
        },
        {
          "recipient_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}